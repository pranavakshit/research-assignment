@startuml "A Comparative Study of Machine Learning Approaches for SMS Spam Detection"
skinparam backgroundColor #FDFDFD
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11
skinparam defaultFontColor #222222
skinparam packageBackgroundColor #F5F7FA
skinparam packageBorderColor #B0BEC5

title A Comparative Study of Machine Learning Approaches for SMS Spam Detection - End-to-End Architecture

package "1. Dataset Acquisition & Ingestion" as P1 {
  [UCI SMS Spam Collection\n(5,574 messages)] as RAW_DATA #E3F2FD
  [Data Loader & Integrity Verifier\n(src/data_loader.py)] as LOADER #BBDEFB
}

package "2. Text Preprocessing & Ablation Layer" as P2 {
  [Text Preprocessor\n(src/preprocessor.py)] as PREPROC #E8F5E9
  [Ablation Controller\n(Preprocessing Enabled vs. Disabled)] as ABL_CTRL #C8E6C9
}

package "3. Multi-Seed Stratified Partitioning" as P3 {
  [Stratified 80/20 Split Engine\n(Seeds: 42, 101, 2024)] as SPLIT #FFF3E0
  [Train Partition (4,459 samples)] as TRAIN_SPLIT #FFE0B2
  [Test Partition (1,115 samples)] as TEST_SPLIT #FFE0B2
}

package "4. Leakage-Free Feature Extraction" as P4 {
  [Sublinear TF-IDF Vectorizer\n(src/feature_extractor.py)\n- Vocabulary: 3,000 terms\n- Sublinear TF (1+log(tf))\n- L2 Normalization] as TFIDF #EDE7F6
  [Fitted Training Vectorizer\n(Zero Contamination)] as FIT_TFIDF #D1C4E9
  [Transformed Test Matrix\n(Out-of-Sample Transform)] as TEST_VEC #D1C4E9
}

package "5. Model Training & Correctness Testing" as P5 {
  [Correctness Check Suite\n(experiments/correctness_check.py)] as TESTS #FFEBEE
  [Multinomial Naive Bayes\n(alpha = 1.0, Laplace)] as MNB #E1F5FE
  [Logistic Regression\n(C = 1.0, L2, L-BFGS)] as LR #E0F2F1
  [Linear Support Vector Classifier\n(C = 1.0, Squared-Hinge)] as SVM #F3E5F5
}

package "6. Controlled Benchmarking & Logging" as P6 {
  [Multi-Seed Benchmark Runner\n(experiments/run_benchmarks.py)] as RUNNER #FCE4EC
  [Ablation Benchmark Runner\n(experiments/run_ablation.py)] as ABL_RUNNER #F8BBD0
  [Raw Results JSONs\n(results/raw/*.json)] as RAW_RESULTS #ECEFF1
  [Consolidated Metrics CSV\n(results/consolidated_results.csv)] as CONSOL_CSV #CFD8DC
  [Ablation Summary CSV\n(results/ablation_summary.csv)] as ABL_CSV #CFD8DC
}

package "7. Statistical Significance & Plotting" as P7 {
  [Statistical Testing Engine\n(experiments/statistical_test.py)] as STATS #FFFDE7
  [Publication Plotting Suite\n(plots/generate_plots.py)] as PLOTTER #FFF9C4
  [Statistical Report\n(results/statistical_significance.txt)] as STAT_REPORT #FFF59D
  [Figure 1: Benchmark Comparison\n(plots/fig1_model_performance.pdf)] as FIG1 #FFF59D
  [Figure 2: Ablation Impact\n(plots/fig2_ablation_impact.pdf)] as FIG2 #FFF59D
  [Figure 3: Confusion Matrices\n(plots/fig3_confusion_matrices.pdf)] as FIG3 #FFF59D
}

package "8. Literature Synthesis & Evidence Package" as P8 {
  [Verified Literature Matrix\n(10 papers, 7 from 2022-2024)\n(literature/literature_matrix.csv)] as LIT_MAT #E0F7FA
  [Systematic Critical Review\n(literature/critical_review.md)] as LIT_REV #B2EBF2
  [Question-Wise Evidence (Q1-Q8)\n(evidence/question_wise_evidence.md)] as EVIDENCE #80DEEA
  [Self-Review & Revision Response\n(paper/self_review_response.md)] as REVIEW_RESP #4DD0E1
}

package "9. IEEE Conference Publication" as P9 {
  [LaTeX Manuscript\n(paper/paper.tex)] as TEX #E8EAF6
  [BibTeX Bibliography\n(paper/references.bib)] as BIB #C5CAE9
  [Compiled Camera-Ready Paper\n(paper/paper.pdf - Exactly 8 Pages)] as PDF #9FA8DA
}

